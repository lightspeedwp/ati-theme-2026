# Copy to .env (gitignored). Values already set in the shell win over this file.

# Target site. Unset means dev. Allowed hosts: ati-holidays.lightspeedwp.dev,
# localhost, 127.0.0.1, ati-holidays.local. Production (ati-holidays.com) is refused.
WP_BASE_URL=https://ati-holidays.lightspeedwp.dev

# Optional. Full Authorization header value for READ-ONLY REST checks in edit
# context (template/part DB overrides). A WordPress application password:
#   WP_REST_AUTH='Basic base64(user:application-password)'
# Leave empty and the `editor` project drops out of the run.
WP_REST_AUTH=

# Opt-in projects (set to true to enable, or use the npm scripts):
#   ATI_RUN_PARITY=true   dev vs live (reads https://ati-holidays.com, GET only, serial)
#   ATI_RUN_VISUAL=true   screenshot comparison
#   ATI_RUN_WIDE=true     1920px breakpoint
